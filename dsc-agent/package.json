{
  "name": "kdk-dsc-agent",
  "version": "1.0.0",
  "description": "KDK DSC Agent — reads USB DSC tokens and bridges them to the KDK web application",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac",
    "rebuild": "electron-rebuild -f -w pkcs11js"
  },
  "dependencies": {
    "node-forge": "^1.3.1",
    "pkcs11js": "^2.1.6",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.0",
    "electron-rebuild": "^3.2.9"
  },
  "build": {
    "appId": "com.kdksoftware.dsc-agent",
    "productName": "KDK DSC Agent",
    "copyright": "Copyright © 2025 KDK Software Pvt Ltd",
    "files": ["main.js", "src/**/*", "assets/**/*"],
    "win": {
      "target": "zip",
      "signAndEditExecutable": false,
      "sign": null
    },
    "mac": {
      "target": "dmg"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "shortcutName": "KDK DSC Agent"
    },
    "linux": {
      "target": "AppImage"
    }
  }
}
